<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!--
  Step 1 of 2 in the ancestor-reconstruction workflow.
  Simulates a 1000-nucleotide alignment on the shared 10-taxon tree under
  JC + Gamma(6, alpha = 0.5); writes a BEAST <data> block.

  Usage: beast -seed 1 simulate.xml
  Output: sim.out.xml — leaf sequences to feed into reconstruct.xml
-->
<beast version="2.0"
       namespace="beast.base.evolution.alignment:beast.base.core:beast.base.inference:beast.base.inference.parameter:beast.base.evolution.sitemodel:beast.base.evolution.substitutionmodel:beast.base.evolution.tree:beastfx.app.seqgen">

  <data id="alignment" dataType="nucleotide">
    <sequence taxon="t1">?</sequence>
    <sequence taxon="t2">?</sequence>
    <sequence taxon="t3">?</sequence>
    <sequence taxon="t4">?</sequence>
    <sequence taxon="t5">?</sequence>
    <sequence taxon="t6">?</sequence>
    <sequence taxon="t7">?</sequence>
    <sequence taxon="t8">?</sequence>
    <sequence taxon="t9">?</sequence>
    <sequence taxon="t10">?</sequence>
  </data>

  <tree id="tree" spec="beast.base.evolution.tree.TreeParser"
        IsLabelledNewick="true" adjustTipHeights="false" taxa="@alignment"
        newick="(t10:0.1100814891,((t1:0.1942750531,(t8:0.01619546459,((t7:0.1779389172,t4:0.08781047076):0.07665834094,t9:0.1642391854):0.1010206869):0.1859799367):0.02725063262,((t5:0.07624672657,t2:0.1346066326):0.1593377476,(t3:0.1636324898,t6:0.001440847095):0.0007756801952):0.1449060839):0.1776036149);"/>

  <run spec="beastfx.app.seqgen.SequenceSimulator" id="seqgen"
       data="@alignment" tree="@tree" sequencelength="1000"
       outputFileName="sim.out.xml">
    <siteModel spec="SiteModel" id="siteModel" gammaCategoryCount="6">
      <parameter name="shape" value="0.5" estimate="false"/>
      <substModel id="jc" spec="JukesCantor"/>
    </siteModel>
  </run>
</beast>
